source "https://rubygems.org"

gem "rails", ENV.fetch("RAILS_VERSION", "~> 7.2.0")
gem "mongo", "~> 2.0"
gem "devise", "~> 4.9"
gem "sqlite3", ENV.fetch("SQLITE_VERSION", "~> 1.4")
gem "logger"
gem "bigdecimal"
gem "mutex_m"
gem "drb"
gem "base64"
gem "benchmark"
gem "ostruct"
gem "simplecov", "~> 0.22", :require => false if ENV["COVERAGE"] == "true"

if RUBY_ENGINE == "ruby" && Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.3")
  gem "commonmarker", "~> 2.10", :require => false
  gem "ruby-gem-release", "0.9.0", :require => false
end

gemspec :path => "../"
